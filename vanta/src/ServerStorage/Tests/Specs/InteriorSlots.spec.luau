--!strict
local Server = game:GetService("ServerScriptService"):WaitForChild("Server")
local InteriorSlots = require(Server.Domain.InteriorSlots)

return function(t)
	t.test("everyone in the same house shares its interior", function()
		local state = InteriorSlots.new(4)
		local a, newA = InteriorSlots.acquire(state, "house:TownHouse01", 0)
		local b, newB = InteriorSlots.acquire(state, "house:TownHouse01", 5)
		t.equal(a, b)
		t.truthy(newA)
		t.falsy(newB)
		local c = InteriorSlots.acquire(state, "house:TownHouse02", 5)
		t.truthy(c ~= a, "another house gets another slot")
	end)

	t.test("an interior is kept while occupied and freed once idle", function()
		local state = InteriorSlots.new(4)
		local slot = InteriorSlots.acquire(state, "house:A", 0)
		t.deepEqual(InteriorSlots.sweep(state, { ["house:A"] = true }, 100, 30), {}, "occupied")
		t.deepEqual(InteriorSlots.sweep(state, {}, 10, 30), {}, "not idle long enough")
		t.deepEqual(InteriorSlots.sweep(state, {}, 31, 30), { "house:A" })
		t.equal(InteriorSlots.slotOf(state, "house:A"), nil)
		local again = InteriorSlots.acquire(state, "room:SquareInn:7", 40)
		t.equal(again, slot, "the freed slot is reused")
	end)

	t.test("touching an interior keeps it alive", function()
		local state = InteriorSlots.new(4)
		InteriorSlots.acquire(state, "house:A", 0)
		InteriorSlots.touch(state, "house:A", 25)
		t.deepEqual(InteriorSlots.sweep(state, {}, 40, 30), {})
	end)

	t.test("no slot when the grid is full", function()
		local state = InteriorSlots.new(2)
		t.truthy(InteriorSlots.acquire(state, "a", 0))
		t.truthy(InteriorSlots.acquire(state, "b", 0))
		local slot = InteriorSlots.acquire(state, "c", 0)
		t.equal(slot, nil)
	end)

	t.test("slots lie on a grid", function()
		local x, y, z = InteriorSlots.position(0, { 3000, 800, -1500 }, 80, 16)
		t.deepEqual({ x, y, z }, { 3000, 800, -1500 })
		x, y, z = InteriorSlots.position(17, { 3000, 800, -1500 }, 80, 16)
		t.deepEqual({ x, y, z }, { 3080, 800, -1420 })
	end)
end
