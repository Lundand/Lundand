--!strict
local Server = game:GetService("ServerScriptService"):WaitForChild("Server")
local InteriorSlots = require(Server.Domain.InteriorSlots)

return function(t)
	t.test("everyone in the same house shares its interior", function()
		local state = InteriorSlots.new(4)
		local a, newA = InteriorSlots.acquire(state, "house:TownHouse01", 0)
		local b, newB = InteriorSlots.acquire(state, "house:TownHouse01", 5)
		t.equal(a, b)
		t.truthy(newA)
		t.falsy(newB)
		local c = InteriorSlots.acquire(state, "house:TownHouse02", 5)
		t.truthy(c ~= a, "another house gets another slot")
	end)

	t.test("an interior is kept while occupied and freed once it has stood empty long enough", function()
		local state = InteriorSlots.new(4)
		local slot = InteriorSlots.acquire(state, "house:A", 0)
		t.deepEqual(InteriorSlots.sweep(state, { ["house:A"] = true }, 100, 30), {}, "occupied for 100 s")
		t.deepEqual(InteriorSlots.sweep(state, {}, 110, 30), {}, "empty for only 10 s")
		t.deepEqual(InteriorSlots.sweep(state, {}, 131, 30), { "house:A" })
		t.equal(InteriorSlots.slotOf(state, "house:A"), nil)
		t.equal(InteriorSlots.keyAt(state, slot :: number), nil)
		local again = InteriorSlots.acquire(state, "room:SquareInn:7", 140)
		t.equal(again, slot, "the freed slot is reused")
		t.equal(InteriorSlots.keyAt(state, again :: number), "room:SquareInn:7")
	end)

	t.test("touching an interior keeps it alive", function()
		local state = InteriorSlots.new(4)
		InteriorSlots.acquire(state, "house:A", 0)
		InteriorSlots.touch(state, "house:A", 25)
		t.deepEqual(InteriorSlots.sweep(state, {}, 40, 30), {})
	end)

	t.test("no slot when the grid is full", function()
		local state = InteriorSlots.new(2)
		t.truthy(InteriorSlots.acquire(state, "a", 0))
		t.truthy(InteriorSlots.acquire(state, "b", 0))
		local slot = InteriorSlots.acquire(state, "c", 0)
		t.equal(slot, nil)
	end)

	t.test("a full grid hands on the interior left empty longest, never one in use", function()
		local state = InteriorSlots.new(3)
		InteriorSlots.acquire(state, "a", 0)
		local b = InteriorSlots.acquire(state, "b", 5)
		InteriorSlots.acquire(state, "c", 10)
		t.equal(InteriorSlots.evictOldest(state, { a = true }), "b")
		t.equal(InteriorSlots.acquire(state, "d", 12), b)
		t.equal(InteriorSlots.evictOldest(state, { a = true, c = true, d = true }), nil)
	end)

	t.test("slots lie on a grid, and a point finds its slot", function()
		local origin = { 3000, 800, -1500 }
		local x, y, z = InteriorSlots.position(0, origin, 80, 16)
		t.deepEqual({ x, y, z }, { 3000, 800, -1500 })
		x, y, z = InteriorSlots.position(17, origin, 80, 16)
		t.deepEqual({ x, y, z }, { 3080, 800, -1420 })
		t.equal(InteriorSlots.slotAt(3080 + 30, -1420 - 30, origin, 80, 16, 256), 17)
		t.equal(InteriorSlots.slotAt(2900, -1500, origin, 80, 16, 256), nil, "west of the grid")
		t.equal(InteriorSlots.slotAt(3000, -1500 + 80 * 16, origin, 80, 16, 256), nil, "past the last row")
	end)
end
