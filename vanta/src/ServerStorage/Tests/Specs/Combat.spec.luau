--!strict
local ServerScriptService = game:GetService("ServerScriptService")
local ServerStorage = game:GetService("ServerStorage")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Server = ServerScriptService:WaitForChild("Server")
local CombatRules = require(Server.Domain.CombatRules)
local EnemyBrain = require(Server.Domain.EnemyBrain)
local Encounters = require(ServerStorage:WaitForChild("ServerData").Encounters)
local Content = require(Shared.Content)

local rules = Content.combat
local sword = rules.disciplines.SwordArts
local learnedAll = { SwordCombo = true, SwordParry = true, HeavyStrike = true, Riposte = true, CrescentSweep = true }
local learnedStart = { SwordCombo = true, SwordParry = true }

local function attack(state: any, action: string, unlocked: any, now: number): (boolean, any)
	local attackId = CombatRules.resolveAttack(state, sword, action, unlocked, now)
	return CombatRules.startAttack(state, sword, attackId, unlocked, now, rules)
end

return function(t)
	t.test("the basic attack chains a three-hit combo, and the chain resets after a pause", function()
		local state = CombatRules.newState()
		local ok, first = attack(state, "Attack", learnedStart, 0)
		t.truthy(ok)
		t.equal(first.id, "Combo1")
		t.falsy(attack(state, "Attack", learnedStart, 0.1), "busy during the swing")
		local _, second = attack(state, "Attack", learnedStart, first.endsAt)
		t.equal(second.id, "Combo2")
		local _, third = attack(state, "Attack", learnedStart, second.endsAt + 0.1)
		t.equal(third.id, "Combo3")
		t.truthy(third.attack.finisher)
		local _, fresh = attack(state, "Attack", learnedStart, third.endsAt + 5)
		t.equal(fresh.id, "Combo1")
		local paused = CombatRules.newState()
		local _, opener = attack(paused, "Attack", learnedStart, 0)
		local _, afterPause = attack(paused, "Attack", learnedStart, opener.endsAt + rules.comboResetSeconds + 0.01)
		t.equal(afterPause.id, "Combo1", "too slow: the chain starts over")
	end)

	t.test("techniques must be learned, and cooldowns hold", function()
		local state = CombatRules.newState()
		t.falsy(attack(state, "Heavy", learnedStart, 0), "Heavy Strike needs Sword Arts rank 2")
		local ok, heavy = attack(state, "Heavy", learnedAll, 0)
		t.truthy(ok)
		t.truthy(heavy.attack.staggers)
		t.falsy(attack(state, "Heavy", learnedAll, heavy.endsAt), "cooling down")
		t.truthy(attack(state, "Heavy", learnedAll, sword.attacks.Heavy.cooldown))
	end)

	t.test("a perfect parry turns a hit into an opening for a riposte", function()
		local state = CombatRules.newState()
		t.truthy(CombatRules.startParry(state, sword, learnedAll, 10))
		t.equal(CombatRules.receiveHit(state, sword, 10.1), "Parried")
		t.equal(CombatRules.receiveHit(state, sword, 10.15), "Hit", "one parry per window")
		local riposteAt = 10 + sword.parry.window + sword.parry.recovery
		t.equal(CombatRules.resolveAttack(state, sword, "Attack", learnedAll, riposteAt), "Riposte")
		t.equal(CombatRules.resolveAttack(state, sword, "Attack", learnedStart, riposteAt), "Combo1", "riposte not learned yet")
		local ok, riposte = attack(state, "Attack", learnedAll, riposteAt)
		t.truthy(ok)
		t.equal(riposte.id, "Riposte")
		local late = CombatRules.newState()
		CombatRules.startParry(late, sword, learnedAll, 0)
		t.equal(CombatRules.receiveHit(late, sword, sword.parry.window + 0.01), "Hit", "too late")
	end)

	t.test("a dodge is briefly invulnerable and has a cooldown", function()
		local state = CombatRules.newState()
		t.truthy(CombatRules.startDodge(state, rules, 0))
		t.equal(CombatRules.receiveHit(state, sword, 0.2), "Dodged")
		t.equal(CombatRules.receiveHit(state, sword, rules.dodge.invulnerable + 0.01), "Hit")
		t.falsy(CombatRules.startDodge(state, rules, rules.dodge.invulnerable + 0.1), "cooling down")
		local staggered = CombatRules.newState()
		CombatRules.stagger(staggered, 0, 1)
		t.falsy(CombatRules.startDodge(staggered, rules, 0.5))
		t.falsy(attack(staggered, "Attack", learnedStart, 0.5))
	end)

	t.test("reach: in front and in range hits; behind misses unless the arc is wide", function()
		local origin, facing = { x = 0, z = 0 }, { x = 0, z = -1 }
		t.truthy(CombatRules.inArc(origin, facing, { x = 0, z = -6 }, 7, 100, 0))
		t.truthy(CombatRules.inArc(origin, facing, { x = 0, z = -9 }, 7, 100, 3), "latency allowance")
		t.falsy(CombatRules.inArc(origin, facing, { x = 0, z = -11 }, 7, 100, 3))
		t.falsy(CombatRules.inArc(origin, facing, { x = 0, z = 5 }, 7, 100, 0), "behind")
		t.truthy(CombatRules.inArc(origin, facing, { x = 5, z = 2 }, 9, 300, 0), "the sweep reaches most of the way round")
		t.truthy(CombatRules.inArc(origin, facing, { x = 0.5, z = 0.5 }, 7, 10, 0), "point blank")
	end)

	t.test("damage scales with weapon, attack and Strength, and is never zero", function()
		t.equal(CombatRules.damage(5, 1.0, 1), 5)
		t.equal(CombatRules.damage(5, 2.4, 1.1), 13)
		t.equal(CombatRules.damage(0, 1, 1), 1)
	end)

	t.test("kill credit goes to everyone who did a fair share", function()
		local ledger = {}
		CombatRules.recordDamage(ledger, "1", 30)
		CombatRules.recordDamage(ledger, "2", 3)
		CombatRules.recordDamage(ledger, "3", 10)
		t.deepEqual(CombatRules.credited(ledger, 40, rules.killCreditShare), { "1", "3" })
	end)

	t.test("enemies chase, telegraph, strike, recover, and go home when pulled too far", function()
		local thief = rules.enemyAttacks.AlleyThief
		local brain = EnemyBrain.new({ x = 0, z = 0 })
		t.deepEqual(EnemyBrain.update(brain, { x = 0, z = 0 }, { { key = 1, x = 50, z = 0 } }, thief, 0, 0), {}, "out of aggro range")
		local chase = EnemyBrain.update(brain, { x = 0, z = 0 }, { { key = 1, x = 20, z = 0 } }, thief, 0, 0)
		t.equal(brain.mode, "Chase")
		t.equal(chase.moveTo.x, 20)
		local windup = EnemyBrain.update(brain, { x = 16, z = 0 }, { { key = 1, x = 20, z = 0 } }, thief, 1, 0)
		t.truthy(windup.telegraph)
		t.equal(windup.face.x, 20)
		t.falsy(EnemyBrain.update(brain, { x = 16, z = 0 }, { { key = 1, x = 20, z = 0 } }, thief, 1.3, 0).strike, "still winding up")
		t.truthy(EnemyBrain.update(brain, { x = 16, z = 0 }, { { key = 1, x = 20, z = 0 } }, thief, 1 + thief.windup, 0).strike)
		t.equal(brain.mode, "Recover")
		local away = EnemyBrain.update(brain, { x = 70, z = 0 }, { { key = 1, x = 75, z = 0 } }, thief, 10, 0)
		t.equal(brain.mode, "Return")
		t.equal(away.moveTo.x, 0)
		local home = EnemyBrain.update(brain, { x = 1, z = 0 }, {}, thief, 12, 0)
		t.truthy(home.reset)
		t.equal(brain.mode, "Idle")
	end)

	t.test("a stagger interrupts an enemy's windup", function()
		local thief = rules.enemyAttacks.AlleyThief
		local brain = EnemyBrain.new({ x = 0, z = 0 })
		EnemyBrain.update(brain, { x = 0, z = 0 }, { { key = 1, x = 3, z = 0 } }, thief, 0, 0)
		EnemyBrain.update(brain, { x = 0, z = 0 }, { { key = 1, x = 3, z = 0 } }, thief, 0.1, 0)
		t.equal(brain.mode, "WindUp")
		EnemyBrain.update(brain, { x = 0, z = 0 }, { { key = 1, x = 3, z = 0 } }, thief, 0.3, 1.3)
		t.equal(brain.mode, "Recover")
		t.falsy(EnemyBrain.update(brain, { x = 0, z = 0 }, { { key = 1, x = 3, z = 0 } }, thief, 0.7, 1.3).strike, "no hit while staggered")
	end)

	t.test("encounters name real enemies, places and quests", function()
		for id, encounter in pairs(Encounters) do
			t.truthy(Content.enemies[encounter.enemyId], id)
			t.truthy(Content.world.locations[encounter.locationId], id)
			t.truthy(encounter.questId == nil or Content.quests[encounter.questId] ~= nil, id)
		end
	end)
end
