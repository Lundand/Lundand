--!strict
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local ResourceRules = require(Shared.Domain.ResourceRules)
local rules = { stamina = { regenPerSecond = 25, regenDelay = 0.8 }, mana = { max = 100, regenPerSecond = 8, regenDelay = 1 } }

return function(t)
	t.test("costs are paid in full or not at all", function()
		local pool = ResourceRules.newPool(100, 50, 0)
		t.truthy(ResourceRules.spend(pool, { stamina = 30, mana = 20 }, 0, rules))
		t.equal(pool.stamina, 70)
		t.equal(pool.mana, 30)
		local ok, reason = ResourceRules.spend(pool, { stamina = 10, mana = 40 }, 0, rules)
		t.falsy(ok)
		t.equal(reason, "not enough mana")
		t.equal(pool.stamina, 70, "nothing taken when the cost can't be paid")
		t.truthy(ResourceRules.spend(pool, nil, 0, rules), "free actions always pass")
	end)

	t.test("regeneration pauses after spending, then refills up to the maximum", function()
		local pool = ResourceRules.newPool(100, 100, 0)
		ResourceRules.spend(pool, { stamina = 50 }, 0, rules)
		ResourceRules.regenerate(pool, 0.5, rules)
		t.equal(pool.stamina, 50, "still paused")
		ResourceRules.regenerate(pool, 1.8, rules)
		t.equal(pool.stamina, 75, "one second of regeneration after the pause")
		ResourceRules.regenerate(pool, 10, rules)
		t.equal(pool.stamina, 100, "never above the maximum")
	end)

	t.test("bad costs are refused, and new maximums keep current values in range", function()
		local pool = ResourceRules.newPool(100, 100, 0)
		t.falsy(ResourceRules.spend(pool, { stamina = -50 }, 0, rules))
		t.falsy(ResourceRules.spend(pool, { stamina = 0 / 0 }, 0, rules))
		t.falsy(ResourceRules.spend(pool, { mana = math.huge }, 0, rules))
		ResourceRules.resize(pool, 80, 120)
		t.equal(pool.stamina, 80)
		t.equal(pool.mana, 100)
		t.truthy(ResourceRules.canAfford(pool, { stamina = 80 }, 0, rules))
		t.falsy(ResourceRules.canAfford(pool, { stamina = 81 }, 0, rules))
	end)
end
