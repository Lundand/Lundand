--!strict
local ServerScriptService = game:GetService("ServerScriptService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local PartyRules = require(ServerScriptService:WaitForChild("Server").Domain.PartyRules)
local Content = require(Shared.Content)

local rules = Content.parties

return function(t)
	t.test("create, join from the board, and the four-player limit", function()
		local state = PartyRules.newState()
		t.truthy(PartyRules.create(state, "p1", 1, "One", "Questing", true, 0, rules))
		t.falsy(PartyRules.create(state, "p2", 1, "One", "Questing", true, 0, rules), "already in a party")
		t.falsy(PartyRules.create(state, "p3", 9, "Nine", "Raiding", true, 0, rules), "unknown goal")
		for userId = 2, 4 do
			t.truthy(PartyRules.join(state, "p1", userId, "P" .. userId, 1, rules))
		end
		t.falsy(PartyRules.join(state, "p1", 5, "Five", 1, rules), "full")
		t.deepEqual(PartyRules.listOpen(state, rules), {}, "full parties leave the board")
	end)

	t.test("unlisted parties are invite-only, and invitations expire", function()
		local state = PartyRules.newState()
		PartyRules.create(state, "p1", 1, "One", "Dungeon", false, 0, rules)
		t.falsy(PartyRules.join(state, "p1", 2, "Two", 1, rules), "not listed")
		t.falsy(PartyRules.invite(state, 2, 3, 1, rules), "only the leader invites")
		t.truthy(PartyRules.invite(state, 1, 2, 1, rules))
		t.truthy(PartyRules.accept(state, "p1", 2, "Two", 2, rules))
		PartyRules.invite(state, 1, 3, 10, rules)
		t.falsy(PartyRules.accept(state, "p1", 3, "Three", 10 + rules.inviteSeconds, rules), "expired")
	end)

	t.test("leadership passes on when the leader leaves, and the last one out disbands it", function()
		local state = PartyRules.newState()
		PartyRules.create(state, "p1", 1, "One", "Exploring", true, 0, rules)
		PartyRules.join(state, "p1", 2, "Two", 1, rules)
		PartyRules.join(state, "p1", 3, "Three", 2, rules)
		local _, party = PartyRules.leave(state, 1)
		t.equal(party.leader, 2, "longest member leads")
		t.falsy(PartyRules.kick(state, 3, 2), "only the leader kicks")
		t.truthy(PartyRules.kick(state, 2, 3))
		t.equal(PartyRules.partyOf(state, 3), nil)
		t.truthy(PartyRules.promote(state, 2, 2) == false, "can't promote yourself")
		local _, after = PartyRules.leave(state, 2)
		t.equal(after, nil, "disbanded")
		t.equal(state.parties.p1, nil)
	end)

	t.test("the board lists open parties with their leader and goal", function()
		local state = PartyRules.newState()
		PartyRules.create(state, "p1", 1, "One", "Gathering", true, 0, rules)
		PartyRules.create(state, "p2", 2, "Two", "Dungeon", false, 0, rules)
		local list = PartyRules.listOpen(state, rules)
		t.equal(#list, 1)
		t.equal(list[1].leaderName, "One")
		t.equal(list[1].goal, "Gathering")
		t.equal(list[1].size, 1)
	end)
end
