--!strict
local ServerScriptService = game:GetService("ServerScriptService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Server = ServerScriptService:WaitForChild("Server")
local VendorRules = require(Server.Domain.VendorRules)
local Transaction = require(Server.Domain.Transaction)
local Content = require(Shared.Content)
local Fixtures = require(script.Parent.Parent.Fixtures)

return function(t)
	t.test("buying is one transaction: pay and receive", function()
		local profile, deps = Fixtures.profile(), Fixtures.deps(42)
		Fixtures.character(profile).currencies.Gold = 100
		local ok, plan = VendorRules.plan(Content.vendors.ForgeTools, "CopperPickaxe", 1, Content.items, 100)
		t.truthy(ok)
		t.truthy(Transaction.apply(profile, "main", { id = "buy1", reason = "Vendor", changes = plan.changes }, deps))
		local character = Fixtures.character(profile)
		t.equal(character.currencies.Gold, 60)
		local _, tool = next(character.inventory.uniques)
		t.equal(tool.itemId, "CopperPickaxe")
		t.equal(tool.origin.kind, "Vendor")
	end)

	t.test("stacks, limits and refusals", function()
		local _, potions = VendorRules.plan(Content.vendors.ApothecaryPotions, "MinorHealthPotion", 3, Content.items, 100)
		t.equal(potions.total, 45)
		t.equal(potions.changes[2].type, "GrantStack")
		t.falsy(VendorRules.plan(Content.vendors.ApothecaryPotions, "MinorHealthPotion", 3, Content.items, 44), "not enough gold")
		t.falsy(VendorRules.plan(Content.vendors.ForgeTools, "CopperPickaxe", 2, Content.items, 500), "one tool at a time")
		t.falsy(VendorRules.plan(Content.vendors.ForgeTools, "TrainingSword", 1, Content.items, 500), "not sold here")
		t.falsy(VendorRules.plan(Content.vendors.ApothecaryPotions, "MinorHealthPotion", 0.5, Content.items, 500))
		t.falsy(VendorRules.plan(Content.vendors.ApothecaryPotions, "MinorHealthPotion", 99, Content.items, 5000))
	end)
end
