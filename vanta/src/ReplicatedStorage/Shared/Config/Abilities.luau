-- Abilities (the owner's class specification): three standard abilities and one End Ability per class, in slots 1 to
-- 4. Each defines its costs (stamina, mana, both or none; End Abilities use the meter), cooldown, timing, hits and
-- presentation. Animations are placeholders reusing the sword set. Values are placeholders to balance in play.
-- Hit fields: at (seconds after the windup), range, arc (degrees), multiplier, staggers.
local Table = require(script.Parent.Parent.Util.Table)

-- Helpers for common hit shapes (used by the Legendary classes below).
local function with(base: any, extra: any?): any
	for key, value in pairs(extra or {}) do
		base[key] = value
	end
	return base
end
local function arc(at: number, range: number, degrees: number, multiplier: number, extra: any?): any
	return with({ at = at, range = range, arc = degrees, multiplier = multiplier }, extra)
end
local function line(at: number, range: number, multiplier: number, extra: any?): any
	return with({ at = at, shape = "line", range = range, radius = 2.5, multiplier = multiplier, speed = 120 }, extra)
end
local function area(at: number, maxRange: number, radius: number, multiplier: number, extra: any?): any
	return with({ at = at, shape = "area", maxRange = maxRange, radius = radius, multiplier = multiplier }, extra)
end
local MAGIC = { damageType = "Magic" }
local function magic(extra: any?): any
	return with({ damageType = "Magic" }, extra)
end

