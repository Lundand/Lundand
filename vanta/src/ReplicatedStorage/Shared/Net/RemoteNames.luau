--!strict
-- Every RemoteEvent the game uses. The server creates them (Server.Net.Remotes); clients wait for them
-- under ReplicatedStorage.Remotes. Arguments from clients are untrusted and validated on the server.
return table.freeze({
	Snapshot = "Snapshot", -- server to client: (section: "Progression" | "Inventory", data)
	Notify = "Notify", -- server to client: (message)
	RequestSnapshot = "RequestSnapshot", -- client to server: ()
	AllocateStats = "AllocateStats", -- client to server: ({ [statId] = points })
	ActivateLegendaryBook = "ActivateLegendaryBook", -- client to server: (bookUid, requestId)
	DevCommand = "DevCommand", -- client to server, development only: (name, args)
	DialogueView = "DialogueView", -- server to client: (view or nil)
	DialogueAction = "DialogueAction", -- client to server: (token, "Continue" | "Skip" | "Choose" | "Close", choiceIndex)
	OpenInterface = "OpenInterface", -- server to client: (kind, data), e.g. "PartyBoard", "PartyInvite", "Crafting", "Rentals"
	PartyRequest = "PartyRequest", -- client to server: (action, args)
	PartyState = "PartyState", -- server to client: (party or nil)
	RequestJournal = "RequestJournal", -- client to server: ()
	AwakeningRitual = "AwakeningRitual", -- server to client: ({ classId, className, position, quick })
	CharacterRequest = "CharacterRequest", -- client to server: (action, args)
	CharacterState = "CharacterState", -- server to client: ({ slots, characters })
	CombatAction = "CombatAction", -- client to server: ("Attack" | "Heavy" | "Sweep" | "Parry" | "Dodge")
	CombatEvent = "CombatEvent", -- server to clients: (actor, animationId, { windup, telegraph }?)
	CombatHit = "CombatHit", -- server to clients: (target, amount, "Hit" | "Parried" | "Dodged")
	AbilityResult = "AbilityResult", -- server to client: (slot, ok, cooldown or refusal reason, dash?)
	EquipItem = "EquipItem", -- client to server: (uid)
	UnequipItem = "UnequipItem", -- client to server: (slot)
	CraftRequest = "CraftRequest", -- client to server: (recipeId)
	VendorBuy = "VendorBuy", -- client to server: (vendorId, itemId, amount)
	VendorSell = "VendorSell", -- client to server: (vendorId, stackKey, uid, amount)
	CosmeticRequest = "CosmeticRequest", -- client to server: ("Buy" | "Wear" | "Remove", cosmeticId)
	PropertyRequest = "PropertyRequest", -- client to server: ("Buy" | "BuyHall", propertyId) or ("SetAccess", propertyId, mode)
	RentalRequest = "RentalRequest", -- client to server: ("Rent", innId, days) or ("Enter", innId)
	GuildRequest = "GuildRequest", -- client to server: (action, args)
	ShopRequest = "ShopRequest", -- client to server: (action, args)
	RiftRequest = "RiftRequest", -- client to server: ("Donate", { product })
})
